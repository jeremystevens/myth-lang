print "=== IMPORT SYSTEM TEST ==="

# -------------------------
# NAMESPACE IMPORT
# -------------------------
# import creates a namespace — access via module.function()

import greetings

greetings.say_hello("Alice")
greetings.say_goodbye("Bob")

# -------------------------
# SECOND MODULE IMPORT
# -------------------------

import mathutils

result = mathutils.square(7)
print result

result = mathutils.double(21)
print result

# -------------------------
# SELECTIVE IMPORT
# -------------------------
# from X import Y brings names directly into scope

from mathutils import double
from mathutils import double, triple

print double(10)
print triple(10)

# -------------------------
# DUPLICATE IMPORT CACHE TEST
# -------------------------
# Silently skipped — already in the import cache

import greetings
import mathutils

greetings.say_hello("CacheTestPassed")

print "=== COMPLETE ==="
