print "=== FILE IO TEST ==="

# -------------------------
# WRITE  — create a new file
# -------------------------

bytes_written = write_file("test_output.txt", "Hello from MyLang!")
print bytes_written

# -------------------------
# EXISTS  — file should now be there
# -------------------------

print file_exists("test_output.txt")
print file_exists("does_not_exist.txt")

# -------------------------
# READ  — get the content back
# -------------------------

content = read_file("test_output.txt")
print content

# -------------------------
# APPEND  — add more content
# -------------------------

append_file("test_output.txt", " Appended line.")
content = read_file("test_output.txt")
print content

# -------------------------
# OVERWRITE  — write_file replaces
# -------------------------

write_file("test_output.txt", "Overwritten content.")
content = read_file("test_output.txt")
print content

# -------------------------
# WRITE MULTIPLE LINES
# -------------------------

write_file("multiline.txt", "line one\nline two\nline three\n")
content = read_file("multiline.txt")
print content

# -------------------------
# APPEND LOOP  — build a log file
# -------------------------

names = ["Alice", "Bob", "Charlie"]

foreach name in names
    append_file("log.txt", name + "\n")
end

log = read_file("log.txt")
print log

# -------------------------
# DELETE  — clean up
# -------------------------

delete_file("test_output.txt")
delete_file("multiline.txt")
delete_file("log.txt")

print file_exists("test_output.txt")
print file_exists("multiline.txt")
print file_exists("log.txt")

print "=== COMPLETE ==="
